# Kopieer naar .env.local (lokaal) of zet in Vercel → Settings → Environment Variables.

# Better Auth: een lange willekeurige sleutel (bv. `openssl rand -base64 32`)
# en het adres waarop de app draait.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://jouw-app.vercel.app

# Google-login: Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application). Redirect-URI:
#   https://jouw-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook-login (optioneel, later): Meta for Developers → app met Facebook Login.
# Redirect-URI: https://jouw-app.vercel.app/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Upstash Redis: zet Vercel zelf via Storage → Upstash for Redis.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
